# ============================================================
# 制作パイプライン用リポジトリの .gitignore
# 追跡するのはパイプライン(tools/)とプロジェクト文書のみ。
# 独立リポ・使い捨て・重量物・ローカル設定は追跡しない。
# ============================================================

# CMS本体は独立した git リポジトリ（ネスト回避のため必須除外）
/site/

# 変換の中間生成物（再生成可能な使い捨て。extract-bundle で再作成される）
/build/

# デザイン原本・重量物（別途アーカイブ保管。再変換時のみローカルに必要）
/mockups/
*.bundle

# 依存（本パイプラインは Node 標準のみ・依存なしだが防御的に）
/node_modules/

# ローカル設定・キャッシュ
/.claude/

# OS / エディタ
Thumbs.db
.DS_Store
*.swp
*~
