# ============================================================
# 制作パイプライン用リポジトリの .gitignore
# 追跡するのはパイプライン(tools/)とプロジェクト文書のみ。
# 独立リポ・使い捨て・重量物・ローカル設定は追跡しない。
# ============================================================

# 案件固有の変換設定（configs/_sample.json をコピーして configs/{案件名}.json を作る。
# cms-core が config.php を追跡せず config.sample.php だけを配る流儀に揃える）
# 案件が増えても一覧しやすいよう configs/ に集約し、実行時は --config で明示指定する。
# ディレクトリごと除外し、雛形だけを否定パターンで戻す
# （否定は後勝ちなので、必ずこの順序を保つこと）。
/configs/*.json
!/configs/_sample.json

# 案件固有の postBuild フック（HTML 文字列リテラル依存で汎用化できない動的ページ組み立て）
/tools/project/

# 案件・コア間の引き継ぎ文書（案件リポの docs/ へ収容するか、都度手渡しで運ぶ）
/handoff_*.md

# 変換の中間生成物（再生成可能な使い捨て。extract-bundle で再作成される）
/build/

# デザイン原本・重量物（別途アーカイブ保管。再変換時のみローカルに必要）
/mockups/
*.bundle

# 依存（本パイプラインは Node 標準のみ・依存なしだが防御的に）
/node_modules/

# ローカル設定・キャッシュ
/.claude/

# OS / エディタ
Thumbs.db
.DS_Store
*.swp
*~
